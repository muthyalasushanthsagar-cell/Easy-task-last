# Copy this file to .env and fill in your real values (never commit .env)

# Spring Boot server port (optional, defaults to 8088)
SERVER_PORT=8088

# Aiven Cloud MySQL credentials
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_password_here
